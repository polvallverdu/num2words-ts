{
  "name": "num2words-ts",
  "version": "1.0.2",
  "description": "Convert numbers to words in 50+ languages. A faithful TypeScript port of the Python num2words library, for Bun, Node, Deno, browsers and Cloudflare Workers.",
  "license": "LGPL-2.1-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polvallverdu/num2words-ts.git"
  },
  "homepage": "https://github.com/polvallverdu/num2words-ts#readme",
  "bugs": {
    "url": "https://github.com/polvallverdu/num2words-ts/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "keywords": [
    "num2words",
    "number to words",
    "numbers",
    "words",
    "i18n",
    "tts",
    "cardinal",
    "ordinal",
    "currency"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lang/*": {
      "types": "./dist/lang/*.d.ts",
      "default": "./dist/lang/*.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "num2words-ts": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "lint": "biome check . && bun tools/check-headers.ts",
    "format": "biome format --write .",
    "fixtures": "python3 -I tools/gen_fixtures.py",
    "compat": "bun tools/compat.ts",
    "kwargs": "python3 -I tools/gen_kwargs.py"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.3",
    "typescript": "7.0.2",
    "workerd": "1.20261005.1"
  },
  "upstream": {
    "num2words": "0.5.14",
    "repository": "https://github.com/savoirfairelinux/num2words"
  }
}
